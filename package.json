{
  "name": "d8js",
  "version": "1.0.0",
  "description": "Ultra-lightweight date formatting for React, Vue, Angular, and Vanilla JS. <1.5KB. Zero deps.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs",
      "types": "./dist/react.d.ts"
    },
    "./angular": {
      "import": "./dist/angular.mjs",
      "require": "./dist/angular.cjs",
      "types": "./dist/angular.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/angular.ts src/react.ts --format esm,cjs --dts --minify --clean",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "date",
    "format",
    "lightweight",
    "react",
    "vue",
    "angular",
    "pipe",
    "javascript",
    "time",
    "tiny-date-formats"
  ],
  "author": {
    "name": "Rohit Kumar",
    "url": "https://github.com/rohit-kumaar"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit-kumaar/tiny-date-formats"
  },
  "homepage": "https://github.com/rohit-kumaar/tiny-date-formats#readme",
  "devDependencies": {
    "@angular/common": "^20.3.10",
    "@angular/core": "^20.3.10",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@angular/core": ">=14.0.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
