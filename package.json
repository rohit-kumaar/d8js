{
  "name": "d8js",
  "version": "1.1.2",
  "description": "Ultra-lightweight date & time formatting utility for JavaScript, React, Vue, Angular. <1.5KB, zero dependencies.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts  --format esm,cjs --dts --minify --clean",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "date",
    "format",
    "lightweight",
    "react",
    "vue",
    "angular",
    "pipe",
    "javascript",
    "time",
    "d8js",
    "datetime"
  ],
  "author": {
    "name": "Rohit Kumar",
    "url": "https://github.com/rohit-kumaar"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit-kumaar/d8js"
  },
  "homepage": "https://github.com/rohit-kumaar/d8js#readme",
  "bugs": {
    "url": "https://github.com/rohit-kumaar/d8js/issues"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  }
}
